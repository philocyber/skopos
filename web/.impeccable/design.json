      "html": "<label class=\"ds-field-label\" for=\"ds-search\">Search records</label><input class=\"ds-input\" id=\"ds-search\" placeholder=\"Search results\">",
      "css": ".ds-field-label{display:block;margin-bottom:8px;font-family:var(--font-sans,Inter),system-ui,sans-serif;font-size:12px;font-weight:500;color:var(--foreground,#18212b);}.ds-input{height:32px;width:100%;padding:4px 10px;border:1px solid var(--input,#becad3);border-radius:var(--radius-md,5px);background:transparent;color:var(--foreground,#18212b);caret-color:var(--primary,#006879);font-family:var(--font-sans,Inter),system-ui,sans-serif;font-size:14px;transition:border-color 150ms,box-shadow 150ms;}.ds-input::placeholder{color:var(--muted-foreground,#566575);}.ds-input:focus-visible{border-color:var(--ring,#007f91);box-shadow:0 0 0 2px color-mix(in srgb,var(--ring,#007f91) 25%,transparent);outline:2px solid var(--ring,#007f91);outline-offset:3px;}.ds-input:disabled{opacity:.5;pointer-events:none;}:host-context(.dark) .ds-input{background:color-mix(in srgb,var(--input) 30%,transparent);}"
