  "narrative": {
    "northStar": "The pentest console",
    "overview": "Skopos is an operational research console with PhiloCyber brand details. Compact controls, quiet navigation and readable evidence take priority over editorial or marketing composition. Inter supplies the interface voice; JetBrains Mono distinguishes identifiers and code. The existing Skopos name and scope-grid logo remain.\n\nThis document describes the implemented default console theme at the `web/` boundary. The separate public landing page retains its own system in [root DESIGN.md](../DESIGN.md). Existing user-selectable layout, font and theme preferences remain available; they are compatibility features, not new defaults. The approved Chat + Auto composition belongs to the [console surface contract](../.impeccable/surfaces/console.md), rather than a rule that every workspace must become a chat layout.",
    "keyCharacteristics": [
      "Dense workspaces with bounded scrolling and persistent task navigation.",
      "Cool neutral surfaces with cyan light-mode and violet dark-mode interaction signals.",
      "Semantic severity and review states that remain distinct from brand accents.",
      "Shared tables, fields and Radix overlays across workspaces."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Brand accents identify interaction; severity and review colors retain their domain meaning.",
        "section": "colors"
      },
      {
        "name": "The Data Type Rule",
        "body": "Keep code and identifiers typographically distinct from interface prose; do not turn workspace headings into display typography.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use the existing border and surface hierarchy for workspaces; reserve stronger elevation for overlays and existing active-control states.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reuse the shared theme tokens, components and focus treatment in every workspace.",
      "**Do** preserve full task navigation, evidence provenance and independent review labels.",
      "**Do** keep scroll ownership explicit so task controls and the chat composer stay available.",
      "**Do** respect reduced-motion preferences, including portalled overlays."
    ],
    "donts": [
      "**Don't** transplant the public landing page's display typography or marketing spacing into the console.",
      "**Don't** replace semantic severity with the cyan or violet brand accent.",
      "**Don't** present missing data as zero, a completed intent as a passed check, or task inspection as authorization.",
      "**Don't** infer mobile acceptance, live agent validation or enforcement guarantees from the desktop synthetic fixtures."
    ]
  }
}
