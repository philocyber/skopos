      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 12px;border:1px solid transparent;border-radius:var(--radius-md,5px);font-family:var(--font-sans,Inter),system-ui,sans-serif;font-size:14px;font-weight:500;white-space:nowrap;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms,box-shadow 150ms;background:color-mix(in srgb,var(--destructive,#b42338) 10%,transparent);color:var(--destructive,#b42338);}.ds-button-destructive:hover{background:color-mix(in srgb,var(--destructive,#b42338) 20%,transparent);}.ds-button-destructive:focus-visible{outline:2px solid var(--ring,#007f91);outline-offset:3px;}.ds-button-destructive:disabled{opacity:.5;pointer-events:none;}"
    },
    {
      "name": "Button / link",
      "kind": "button",
      "description": "Existing link button variant with theme-bound color, hover and focus.",
      "html": "<button class=\"ds-button-link\">Details</button>",
      "css": ".ds-button-link{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 12px;border:1px solid transparent;border-radius:var(--radius-md,5px);font-family:var(--font-sans,Inter),system-ui,sans-serif;font-size:14px;font-weight:500;white-space:nowrap;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms,box-shadow 150ms;background:transparent;color:var(--primary,#006879);text-underline-offset:4px;}.ds-button-link:hover{text-decoration:underline;}.ds-button-link:focus-visible{outline:2px solid var(--ring,#007f91);outline-offset:3px;}.ds-button-link:disabled{opacity:.5;pointer-events:none;}"
