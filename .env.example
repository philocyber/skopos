# Docker deployment configuration: copy to .env.
# Compose builds Skopos locally from this checkout.
# Management uses HTTPS: provide tls/server.pem and tls/server-key.pem before startup.
# The certificate must be valid for the client hostname and trusted by clients.
SKOPOS_LANGUAGE=en
SKOPOS_TRAFFIC_BLOB_BYTES=1073741824
SKOPOS_TRAFFIC_INDEX_BYTES=1073741824
SKOPOS_TRAFFIC_WAL_BYTES=134217728
# Keep this much available volume space before admitting traffic writes.
SKOPOS_TRAFFIC_FREE_BYTES=268435456
# Logical capture bytes: request/response bodies, headers, metadata and row overhead.
SKOPOS_TRAFFIC_EXCHANGE_BYTES=67108864
SKOPOS_TRAFFIC_HOST_BYTES=268435456
# Maximum retained exchanges for new capture; saved evidence is never evicted.
SKOPOS_TRAFFIC_MAX_EXCHANGES=100000
# Per task archive: raw payload, compressed package and extracted data ceilings.
SKOPOS_TASK_ARCHIVE_BYTES=4294967296
# Additional trusted recording-proxy client CIDRs; empty permits loopback only.
# Docker host access needs an explicit trusted bridge/client CIDR as seen by the container.
SKOPOS_PROXY_CLIENT_CIDRS=
POSTGRES_USER=skopos
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=skopos

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SKOPOS_LLM_PROVIDER=
SKOPOS_LLM_MODEL=
SKOPOS_LLM_BASE_URL=
SKOPOS_LLM_PROXY=
